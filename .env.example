# Copier en ".env" pour le developpement local.
# En production ces valeurs viennent de /opt/instad/.env.map sur l'EC2
# (cf. instad-infra/.env.map.example), jamais de ce fichier.

PORT=5000
NODE_ENV=development

# Local : mongo sur la machine. En production : le conteneur "mongo" partage
# avec INSTAD, sur une base dediee (rgph_djibouti_2024).
MONGODB_URI=mongodb://localhost:27017/rgph_djibouti_2024

# Origine autorisee par CORS. En production le frontend et l'API sont servis
# par le meme domaine (nginx envoie /api/ vers cette API), donc les appels du
# navigateur sont en meme origine : cette valeur ne sert que de garde-fou.
CORS_ORIGIN=http://localhost:3000

# Fenetre de limitation de debit (15 min) et nombre max de requetes par IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Mettre a "true" uniquement sur une machine dediee : un worker par CPU.
# Sur l'EC2 partage, laisser false (impose par le Dockerfile).
USE_CLUSTER=false
